-- Program: LDI A,7  LDI B,2  ADD A,A,B  HLT
-- Rejestry w instrukcji: 0000=A, 0001=B, ..., 1111=P

WIDTH=16;
DEPTH=1024;

ADDRESS_RADIX = HEX;
DATA_RADIX    = HEX;

CONTENT BEGIN
    000 : 4007;   -- LDI A, 7
    001 : 4202;   -- LDI B, 2
    002 : 2201;   -- ADD A, A, B  (ALU ADD=00010)
    003 : 1F00;   -- HLT
    010 : 00AB;   -- dane testowe LOAD
    [004..00F] : 0000;
    [011..0FF] : 0000;
    [100..1FF] : 0000;
    [200..2FF] : 0000;
    [300..3FF] : 0000;
END;
