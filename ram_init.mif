WIDTH=16;
DEPTH=1024;

ADDRESS_RADIX = HEX;
DATA_RADIX    = HEX;

CONTENT BEGIN
    -- Program demonstracyjny jednostki sterujacej:
    -- rA = 7, rB = 2, rA = rA + rB, rA = rA * rB,
    -- MEM[0x20] = rA, rC = MEM[0x20], HLT.
    000 : 4407;  -- LDI rA, 0x07
    001 : 4602;  -- LDI rB, 0x02
    002 : 2023;  -- ADD rA, rB  -> rA = 9
    003 : 2223;  -- MUL rA, rB  -> rA = 18 (0x0012)
    004 : 8420;  -- STORE rA, [0x20]
    005 : 6820;  -- LOAD rC, [0x20]
    006 : 1F00;  -- HLT

    [007..01F] : 0000;
    020 : 0000;  -- miejsce na wynik STORE
    [021..3FF] : 0000;
END;
