-- Quartus Prime generated Memory Initialization File (.mif)

WIDTH=16;
DEPTH=1024;

ADDRESS_RADIX = HEX; -- format adresow: HEX / DEC / OCT / BIN
DATA_RADIX    = HEX; -- format danych:  HEX / DEC / OCT / BIN


CONTENT BEGIN
    000 : 0001;      -- segment 0
    001 : 0002;
    002 : 0003;
    003 : ABCD;
    004 : 1234;
    005 : FFFF;
    100 : 0010;      -- segment 1 (adres 256 dec)
    200 : 0020;      -- segment 2 (adres 512 dec)
    300 : 0030;      -- segment 3 (adres 768 dec)
    [006..0FF] : 0000; -- wypelnienie segmentu 0
    [101..1FF] : 0000;
    [201..2FF] : 0000;
    [301..3FF] : 0000;
END;